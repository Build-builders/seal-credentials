{
  "name": "@acta-team/seal",
  "version": "0.1.0",
  "description": "React SDK to interact with the ACTA API and manage verifiable credentials on the Stellar blockchain.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ACTA-Team/seal-credentials.git"
  },
  "keywords": [
    "react",
    "hooks",
    "acta",
    "seal",
    "credentials",
    "stellar",
    "verifiable-credentials"
  ],
  "author": "ACTA",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.20",
    "@types/react": "^18.2.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
